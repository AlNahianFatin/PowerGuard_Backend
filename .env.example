NODE_ENV=<Node environment - `development` | `production`>
PORT=<Port number for development>

# This was inserted by `prisma init`:
# Environment variables declared in this file are NOT automatically loaded by Prisma.
# Please add `import "dotenv/config";` to your `prisma.config.ts` file, or use the Prisma CLI with Bun
# to load environment variables from .env files: https://pris.ly/prisma-config-env-vars.

# Prisma supports the native connection string format for PostgreSQL, MySQL, SQLite, SQL Server, MongoDB and CockroachDB.
# See the documentation for all the connection string options: https://pris.ly/d/connection-strings

DATABASE_URL=<Database URL>

JWT_ACCESS_SECRET=<Long random string>
JWT_REFRESH_SECRET=<Long random string>
JWT_ACCESS_EXPIRES_IN=1d
JWT_REFRESH_EXPIRES_IN=7d

BCRYPT_SALT_ROUNDS=<Number of Bcrypt salt rounds>

# Used to build absolute links back to this API (not read anywhere yet).
BACKEND_URL=<Backend URL>

# Allowed CORS origin for the browser client.
FRONTEND_URL=<Frontend URL>

GOOGLE_CLIENT_ID=<Google Client ID for Google verification>

TESTER_ADMIN_NAME=<Tester admin name>
TESTER_ADMIN_EMAIL=<Tester admin email>
TESTER_ADMIN_PASSWORD=<Tester admin password>


TESTER_OPERATOR_NAME=<Tester operator name>
TESTER_OPERATOR_EMAIL=<Tester operator email>
TESTER_OPERATOR_PASSWORD=<Tester operator password>


TESTER_TECHNICIAN_NAME=<Tester technician name>
TESTER_TECHNICIAN_EMAIL=<Tester technician email>
TESTER_TECHNICIAN_PASSWORD=<Tester technician password>


TESTER_CUSTOMER_NAME=<Tester customer name>
TESTER_CUSTOMER_EMAIL=<Tester customer email>
TESTER_CUSTOMER_PASSWORD=<Tester customer password>


REDIS_USER=<Redis username>
REDIS_PASSWORD=<Redis password> 
REDIS_HOST=<Redis host ID>
REDIS_PORT=<Redis port number>

SMTP_USER=<SMTP user name/email>
EMAIL_SENDER=<SMTP user email>
SMTP_PASSWORD=<SMTP user password>

CLOUDINARY_CLOUD_NAME=<Cloudinary user name>
CLOUDINARY_API_KEY=<Cloudinary API key>
CLOUDINARY_API_SECRET=<Cloudinary API secret>

BKASH_BASE_URL=<Bkash base URL>
BKASH_USERNAME=<Bkash username>
BKASH_PASSWORD=<Bkash password>
BKASH_APP_KEY=<Bkash key>
BKASH_APP_SECRET=<Bkash secret>
BKASH_CALLBACK_URL=<Bkash backend callback URL>

FRONTEND_TECHNICIAN_CHANGE_PASS_LINK=<Frontend technician password change URL>