model OutageReport {
  id          String  @id @default(uuid())
  title       String
  description String?

  status OutageReportStatus @default(PENDING)

  isFailed    Boolean @default(false)
  failureNote String?
  
  isRejected      Boolean @default(false)
  rejectionReason String?

  assignedAt DateTime?
  resolvedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  isDeleted Boolean   @default(false)
  deletedBy String?
  user      User?     @relation(fields: [deletedBy], references: [id])
  deletedAt DateTime?

  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  areaId String
  area   Area   @relation(fields: [areaId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  assignments Assignment[]

  // feederId String?
  // feeder   Feeder? @relation(fields: [feederId], references: [id])

  @@index([status])
  @@index([customerId])
  @@index([areaId])
  @@map("outagereports")
}
