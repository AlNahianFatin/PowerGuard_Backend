model Assignment {
  id String @id @default(uuid())

  notes String?

  reportUrl      String?
  reportPublicId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  isDeleted     Boolean   @default(false)
  deletedBy     String?
  deletedByUser User?     @relation("deletion", fields: [deletedBy], references: [id])
  deletedAt     DateTime?

  assigneeId     String
  assignedByUser User   @relation("assignment", fields: [assigneeId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  technicianId String
  technician   Technician @relation(fields: [technicianId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  serviceRequestId String         @unique
  serviceRequest   ServiceRequest @relation(fields: [serviceRequestId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  payment Payment?

  technicianReportId String?
  technicianReport   TechnicianReport? @relation(fields: [technicianReportId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  // operator           Operator?         @relation(fields: [operatorId], references: [id])
  // operatorId         String?
  // user               User?             @relation(fields: [userId], references: [id])
  // userId             String?

  @@unique([assigneeId, technicianId, serviceRequestId], name: "unique_assignment")
  @@map("assignments")
}
