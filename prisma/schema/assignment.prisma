model Assignment {
  id String @id @default(uuid())

  notes String?

  reportUrl      String?
  reportPublicId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  isDeleted Boolean   @default(false)
  deletedBy String?
  user      User?     @relation(fields: [deletedBy], references: [id])
  deletedAt DateTime?

  operatorId String
  operator   Operator? @relation(fields: [operatorId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  technicianId String
  technician   Technician? @relation(fields: [technicianId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  serviceRequestId String         @unique
  serviceRequest   ServiceRequest @relation(fields: [serviceRequestId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  payment Payment?

  technicianReportId String?
  technicianReport   TechnicianReport? @relation(fields: [technicianReportId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@unique([operatorId, technicianId, serviceRequestId], name: "unique_assignment")
  @@map("assignments")
}
