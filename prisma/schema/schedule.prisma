model Schedule {
  id String @id @default(uuid())

  startDateTime DateTime
  endDateTime   DateTime

  reason String
  status ScheduleStatus @default(DRAFT)

  isDeleted Boolean   @default(false)
  deletedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  feederId String
  feeder   Feeder @relation(fields: [feederId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  operatorId String
  operator   Operator @relation(fields: [operatorId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@unique([startDateTime, endDateTime], name: "unique_schedule")
  @@map("schedules")
}
