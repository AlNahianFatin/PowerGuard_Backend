model DistributionZone {
  id          String  @id @default(uuid())
  name        String
  code        String  @unique
  description String?

  substations Substation[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([name])
  @@index([code])
  @@map("distributionzones")
}
